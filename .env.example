# Root .env — single source of truth for backend secrets across the monorepo.
# Copy this file to `.env` (gitignored) and fill in real values. The API worker
# pulls these in automatically: `bun run dev:api` runs scripts/sync-env.ts
# first, which copies this file's contents into apps/api/.dev.vars so Wrangler
# loads them as bindings.
#
# Frontend env (EXPO_PUBLIC_*) still lives in apps/app/.env — Expo only reads
# from its own workspace.

# OpenAI Moderation API — used by apps/api/src/services/moderation.ts
OPENAI_API_KEY=sk-...

# Postgres connection string for Drizzle (use the pooled Supabase URL)
DATABASE_URL=postgresql://user:pass@host:6543/postgres

# Supabase project — only needed if using Supabase-specific APIs beyond Postgres
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Toggle moderation on/off in local dev. When "false" the moderation service
# returns a "skipped" verdict without hitting OpenAI, so you can develop
# without a key.
MODERATION_ENABLED=true

# Per-category thresholds live in apps/api/src/services/moderation.ts
# (CATEGORY_THRESHOLDS map). Edit that constant to tune strictness per
# category. Each call logs every category's score + threshold to the
# wrangler dev console so you can see why a verdict came out the way it did.

# --- Dev-only auth bypass -----------------------------------------------------
# When set to a UUID present in app.users, the API accepts
# `Authorization: Bearer dev` and resolves the request to that user without
# verifying a Clerk JWT. Use this until @clerk/clerk-expo is wired into the
# mobile app. Leave UNSET in production.
# DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000002
