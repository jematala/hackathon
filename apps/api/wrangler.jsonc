{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jematala-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-18",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "logpush": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "routes": [
    {
      "pattern": "jematala.takuk.me/api/*",
      "zone_name": "takuk.me",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CAMPUS_REALTIME_ROOM",
        "class_name": "CampusRealtimeRoomDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CampusRealtimeRoomDO"],
    },
  ],
  "triggers": {
    "crons": ["0 21 * * *", "*/30 * * * *"],
  },
}
