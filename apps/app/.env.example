# Base URL for the Hono API on Cloudflare Workers (used when EXPO_PUBLIC_USE_MOCK_API != "true")
EXPO_PUBLIC_API_URL=http://localhost:8787

# Mock API is on by default. Set to "false" once the real API routes land on this branch
# and you want to hit EXPO_PUBLIC_API_URL instead.
EXPO_PUBLIC_USE_MOCK_API=true

# Default dev user identity sent as x-user-id. Switchable in-app via the dev pill.
# Seeded users from packages/db/supabase/reset.sql: "demo-user", "demo-admin".
EXPO_PUBLIC_DEV_USER_ID=demo-user
