{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jematala-app",
  "compatibility_date": "2026-05-18",
  "routes": [
    {
      "pattern": "jematala.takuk.me/*",
      "zone_name": "takuk.me",
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
