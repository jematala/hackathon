{
  "name": "hackathon",
  "devDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "latest"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "dev": "bun run dev:app",
    "dev:app": "bun --cwd apps/app start",
    "dev:api": "bun --cwd apps/api dev",
    "build": "bun run build:app && bun run build:api",
    "build:app": "bun --cwd apps/app build:web",
    "build:api": "bun --cwd apps/api build",
    "typecheck": "bun run typecheck:app && bun run typecheck:api && bun run typecheck:shared && bun run typecheck:db",
    "typecheck:app": "bun --cwd apps/app typecheck",
    "typecheck:api": "bun --cwd apps/api typecheck",
    "typecheck:shared": "bun --cwd packages/shared typecheck",
    "typecheck:db": "bun --cwd packages/db typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
